<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Arka plan rengi -->
    <solid android:color="#FFFFFF" />

    <!-- Kenarlık -->
    <stroke
        android:width="1dp"
        android:color="#CCCCCC" />

    <!-- Köşe yumuşatma -->
    <corners android:radius="10dp" />

    <!-- İç boşluk -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>
