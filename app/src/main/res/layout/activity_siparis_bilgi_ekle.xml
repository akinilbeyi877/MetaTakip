<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EEF2F7">

    <!-- ══ HERO ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1976D2"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📦 SİPARİŞ EKLE"
            android:textColor="#BBDEFB"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MÜŞTERİ ADI"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="2" />

        <TextView
            android:id="@+id/tvMusteriTelefon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#90CAF9"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- ══ SCROLL ══ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- ── Sipariş Bilgileri ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📋 SİPARİŞ BİLGİLERİ"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#90A4AE"
                android:paddingStart="2dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Durum + Tarih -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SİPARİŞ DURUMU"
                                android:textSize="9sp"
                                android:textColor="#90A4AE"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp" />
                            <Spinner
                                android:id="@+id/spSiparisDurumu"
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:background="@drawable/spinner_border"
                                android:paddingStart="8dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TESLİM TARİHİ"
                                android:textSize="9sp"
                                android:textColor="#90A4AE"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp" />
                            <EditText
                                android:id="@+id/etTeslimTarihi"
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:hint="---"
                                android:inputType="none"
                                android:focusable="false"
                                android:background="@drawable/spinner_border"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:textSize="13sp"
                                android:gravity="center_vertical"
                                android:textColor="#1A237E" />
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F1F5F9" android:layout_marginStart="14dp" />

                    <!-- Sipariş Notu -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="📝 SİPARİŞ NOTU"
                                android:textSize="9sp"
                                android:textColor="#90A4AE"
                                android:textStyle="bold" />
                            <!-- Sipariş özetini nota yazar + panoya kopyalar -->
                            <ImageButton
                                android:id="@+id/btnKopyalaNotlar"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@android:drawable/ic_menu_share"
                                android:background="@null"
                                android:tint="#43A047"
                                android:contentDescription="Bilgileri Kopyala" />
                            <ImageButton
                                android:id="@+id/btnWhatsapp"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@android:drawable/ic_dialog_info"
                                android:background="@null"
                                android:tint="#1976D2"
                                android:contentDescription="WhatsApp" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/etSiparisNotu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="96dp"
                            android:hint="Sipariş ile ilgili notlar buraya..."
                            android:background="@drawable/spinner_border"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:textSize="13sp"
                            android:textColor="#1A237E"
                            android:gravity="top|start"
                            android:inputType="textMultiLine"
                            android:scrollbars="vertical"
                            android:overScrollMode="always"
                            android:maxLines="8" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── İşlemler ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔧 İŞLEMLER"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#90A4AE"
                android:paddingStart="2dp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <Button
                        android:id="@+id/btnIndirimEkle"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="- İndirim"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#78909C"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnUcretEkle"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="+ Ücret"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#546E7A"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnTumunuSil"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="🗑 Sil"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#E53935"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnUrunEkle"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="➕ Ürün"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#1565C0"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Ürün Listesi + Toplam ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📦 ÜRÜN LİSTESİ"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#90A4AE"
                android:paddingStart="2dp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Satırlar -->
                    <LinearLayout
                        android:id="@+id/layoutUrunListe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp" />

                    <!-- ── GENEL TOPLAM ŞERIT — 3 temiz bölüm ── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:background="#1565C0">

                        <!-- ADET -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ADET"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textColor="#90CAF9" />
                            <TextView
                                android:id="@+id/tvToplamAdet"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center_vertical"
                            android:background="#42A5F5" />

                        <!-- M² -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="M²"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textColor="#90CAF9" />
                            <TextView
                                android:id="@+id/tvToplamM2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center_vertical"
                            android:background="#42A5F5" />

                        <!-- GENEL TOPLAM -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="2"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="GENEL TOPLAM"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textColor="#90CAF9" />
                            <TextView
                                android:id="@+id/tvGenelToplam"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0,00 ₺"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- ══ KAYDET ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:padding="12dp">

        <Button
            android:id="@+id/btnKaydet"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="✔  KAYDET"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#1565C0" />
    </LinearLayout>

</LinearLayout>
