<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Telefon numarasını kontrol edin ve gerekirse düzeltin:"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvMevcutTelefon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mevcut Telefon: "
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"
        android:textColor="#FF5722" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Telefon Numarası:"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etDogrulamaTelefon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="05xx xxx xx xx"
        android:inputType="phone"
        android:maxLines="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Not: Numarayı değiştirmezseniz mevcut numaraya gönderilecektir."
        android:textSize="12sp"
        android:textColor="#757575"
        android:layout_marginTop="8dp" />

</LinearLayout>