<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#EEF2F7">

    <!-- Başlık -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:background="#1565C0"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ EK ÜCRET EKLE"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- TL / % CHECKBOX STİL -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ÜCRET TİPİ"
                    android:textSize="10sp"
                    android:textColor="#90A4AE"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rgUcretTip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbTL"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="✔  ₺ TL"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/radio_text_color"
                        android:gravity="center"
                        android:checked="true"
                        android:background="@drawable/checkbox_selector"
                        android:button="@null"
                        android:clickable="true"
                        android:focusable="true" />

                    <RadioButton
                        android:id="@+id/rbPercent"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="✔  % ORAN"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/radio_text_color"
                        android:gravity="center"
                        android:background="@drawable/checkbox_selector"
                        android:button="@null"
                        android:clickable="true"
                        android:focusable="true" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TUTAR -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tutar"
                    android:textSize="12sp"
                    android:textColor="#90A4AE"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etUcretDeger"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:hint="0"
                    android:inputType="numberDecimal"
                    android:textSize="20sp"
                    android:textColor="#1565C0"
                    android:textStyle="bold"
                    android:gravity="end"
                    android:background="@null" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- AÇIKLAMA -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:minHeight="48dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝"
                    android:textSize="15sp"
                    android:layout_marginEnd="8dp" />
                <EditText
                    android:id="@+id/etUcretAciklama"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Açıklama (sipariş notuna eklenir)"
                    android:background="@null"
                    android:textSize="13sp"
                    android:textColor="#1A237E"
                    android:inputType="textMultiLine"
                    android:maxLines="2" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- BUTONLAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnIptal"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="İPTAL"
                android:textColor="#1565C0"
                android:textStyle="bold"
                android:textSize="13sp"
                android:backgroundTint="#E3F2FD"
                android:layout_marginEnd="5dp" />

            <Button
                android:id="@+id/btnSil"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="🗑 SİL"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:backgroundTint="#E53935"
                android:layout_marginEnd="5dp" />

            <Button
                android:id="@+id/btnEkle"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="EKLE"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:backgroundTint="#1565C0" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
