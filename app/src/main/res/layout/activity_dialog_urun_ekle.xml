<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#EEF2F7">

    <!-- ══ HERO BAŞLIK ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#1976D2">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="➕ ÜRÜN EKLE"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvUyari"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFCDD2"
            android:textSize="10sp"
            android:gravity="center"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ══ İÇERİK ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- ── Ürün Tipi + Fiyat Kartı ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Ürün Tipi satırı -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="10dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="#E3F2FD"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="🏷️"
                            android:textSize="15sp" />
                    </androidx.cardview.widget.CardView>

                    <Spinner
                        android:id="@+id/spUrun"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/spinner_border"
                        android:paddingStart="8dp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#F1F5F9" android:layout_marginStart="56dp" />

                <!-- Fiyat satırı (otomatik) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="10dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="#E8F5E9"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="₺"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#2E7D32" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="FİYAT"
                        android:textSize="10sp"
                        android:textColor="#90A4AE"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFiyat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Ölçüler Kartı ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ADET + M2 satırı -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="10dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="#FFF3E0"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="#"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#E65100" />
                    </androidx.cardview.widget.CardView>

                    <!-- ADET -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ADET"
                            android:textSize="9sp"
                            android:textColor="#90A4AE"
                            android:textStyle="bold" />
                        <EditText
                            android:id="@+id/etAdet"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:inputType="number"
                            android:background="@null"
                            android:textSize="15sp"
                            android:textColor="#1A237E"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="26dp"
                        android:background="#E3F2FD" />

                    <!-- M2 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="M²"
                            android:textSize="9sp"
                            android:textColor="#90A4AE"
                            android:textStyle="bold" />
                        <EditText
                            android:id="@+id/etM2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="0.0"
                            android:inputType="numberDecimal"
                            android:background="@null"
                            android:textSize="15sp"
                            android:textColor="#1A237E"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#F1F5F9" android:layout_marginStart="56dp" />

                <!-- EN + BOY satırı -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="10dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="#EDE7F6"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="📏"
                            android:textSize="13sp" />
                    </androidx.cardview.widget.CardView>

                    <!-- EN -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EN"
                            android:textSize="9sp"
                            android:textColor="#90A4AE"
                            android:textStyle="bold" />
                        <EditText
                            android:id="@+id/etEn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="0.0"
                            android:inputType="numberDecimal"
                            android:background="@null"
                            android:textSize="15sp"
                            android:textColor="#1A237E" />
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="26dp"
                        android:background="#E3F2FD" />

                    <!-- BOY -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BOY"
                            android:textSize="9sp"
                            android:textColor="#90A4AE"
                            android:textStyle="bold" />
                        <EditText
                            android:id="@+id/etBoy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="0.0"
                            android:inputType="numberDecimal"
                            android:background="@null"
                            android:textSize="15sp"
                            android:textColor="#1A237E" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── ALT BUTONLAR ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnIptal"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="İPTAL"
                android:textColor="#1565C0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#E3F2FD"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnEkle"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="✔  EKLE"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#1565C0" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
