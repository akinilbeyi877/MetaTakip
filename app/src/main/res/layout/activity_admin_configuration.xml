<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF2F7"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ══════════════════════════════════════
             🔵 HERO — mavi başlık
             ══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1976D2"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚙️ Ayarlar"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sistem Yönetimi ve Yapılandırma"
                android:textSize="13sp"
                android:textColor="#90CAF9" />
        </LinearLayout>

        <!-- ══════════════════════════════════════
             İÇERİK
             ══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── YÖNETİM ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📋 YÖNETİM"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#90A4AE"
                android:paddingStart="2dp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 👤 Personel -->
                    <LinearLayout
                        android:id="@+id/btnPersonelEkle"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="14dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:text="👤"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#E3F2FD" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Yetkili Personel Ekle"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E" />
                        <TextView
                            android:id="@+id/tvPersonelCount"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="#1976D2"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#E3F2FD" />
                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="22sp"
                            android:textColor="#BDBDBD"
                            android:gravity="center"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="#F5F5F5" />

                    <!-- 🏢 Firma -->
                    <LinearLayout
                        android:id="@+id/btnFirmaBilgileri"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="14dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:text="🏢"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#E8F5E9" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Firma Bilgileri"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E" />
                        <TextView
                            android:id="@+id/tvFirmaCount"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="#2E7D32"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#E8F5E9" />
                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="22sp"
                            android:textColor="#BDBDBD"
                            android:gravity="center"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="#F5F5F5" />

                    <!-- 🏷️ Ürün Tipi -->
                    <LinearLayout
                        android:id="@+id/btnUrunTipiYonetimi"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="14dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:text="🏷️"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#F3E5F5" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Ürün Tipi Yönetimi"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E" />
                        <TextView
                            android:id="@+id/tvUrunTipiCount"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="#6A1B9A"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#F3E5F5" />
                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="22sp"
                            android:textColor="#BDBDBD"
                            android:gravity="center"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="#F5F5F5" />

                    <!-- 📝 Mesaj Şablonları -->
                    <LinearLayout
                        android:id="@+id/btnMesajSablonlari"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="14dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:text="📝"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#E3F2FD" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Mesaj Şablonları"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E" />
                        <TextView
                            android:id="@+id/tvMesajSablonCount"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="#1565C0"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#E3F2FD" />
                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="22sp"
                            android:textColor="#BDBDBD"
                            android:gravity="center"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="#F5F5F5" />

                    <!-- 🏷 Ünvan -->
                    <LinearLayout
                        android:id="@+id/btnUnvanYonetimi"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="14dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:text="🏷"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#FFF3E0" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Ünvan Yönetimi"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E" />
                        <TextView
                            android:id="@+id/tvUnvanCount"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="#E65100"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#FFF3E0" />
                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="22sp"
                            android:textColor="#BDBDBD"
                            android:gravity="center"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="#F5F5F5" />

                    <!-- 🏷️ Etiket -->
                    <LinearLayout
                        android:id="@+id/btnEtiketAyarlari"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="14dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:text="🏷️"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#EDE7F6" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Etiket Ayarları"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E" />
                        <TextView
                            android:id="@+id/tvEtiketSablonCount"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="#4A148C"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#EDE7F6" />
                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="22sp"
                            android:textColor="#BDBDBD"
                            android:gravity="center"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── SİPARİŞ ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="❌ SİPARİŞ"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#90A4AE"
                android:paddingStart="2dp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- ❌ İptal Edilenler -->
                    <LinearLayout
                        android:id="@+id/btnIptalEdilenler"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="14dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:text="❌"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#FFEBEE" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="İptal Edilen Siparişler"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E" />
                        <TextView
                            android:id="@+id/tvIptalSiparisCount"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="#C62828"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#FFEBEE" />
                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="22sp"
                            android:textColor="#BDBDBD"
                            android:gravity="center"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── ÇAĞRI ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📞 ÇAĞRI"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#90A4AE"
                android:paddingStart="2dp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 📞 Çağrı Kayıtları -->
                    <LinearLayout
                        android:id="@+id/btnCallLogs"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="14dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:text="📞"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#E8F5E9" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Çağrı Kayıtları"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E" />
                        <TextView
                            android:id="@+id/tvCallLogsCount"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="#2E7D32"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#E8F5E9" />
                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="22sp"
                            android:textColor="#BDBDBD"
                            android:gravity="center"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="#F5F5F5" />

                    <!-- ➕ Çağrı Ekle -->
                    <LinearLayout
                        android:id="@+id/btnAddCallLog"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="14dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:text="➕"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#E8F5E9" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Çağrı Ekle"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E" />
                        <TextView
                            android:id="@+id/tvAddCallCount"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="#2E7D32"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#E8F5E9" />
                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="22sp"
                            android:textColor="#BDBDBD"
                            android:gravity="center"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="#F5F5F5" />

                    <!-- 🗑️ Silme Geçmişi -->
                    <LinearLayout
                        android:id="@+id/btnSilmeGecmisi"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="14dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:text="🗑️"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#FFEBEE" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Silinen Siparişler / Geçmiş"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E" />
                        <TextView
                            android:id="@+id/tvSilinenSiparisCount"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="#C62828"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="#FFEBEE" />
                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="22sp"
                            android:textColor="#BDBDBD"
                            android:gravity="center"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── SİSTEM ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💾 SİSTEM"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#90A4AE"
                android:paddingStart="2dp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <!-- 💾 Veritabanı — Button tipini koruyoruz (Kotlin uyumu) -->
                    <Button
                        android:id="@+id/btnVeritabani"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="8dp"
                        android:text="💾  Veritabanı Yönetimi"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#E65100" />

                    <!-- ☁️ Drive Backup — Button tipini koruyoruz -->
                    <Button
                        android:id="@+id/btnDriveBackup"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="☁️  Drive Otomatik Yedek"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#1565C0" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 🔙 Geri Dön — tam genişlik, alt kısım -->
            <Button
                android:id="@+id/btnGeri"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="8dp"
                android:text="🔙  Geri Dön"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#546E7A" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
