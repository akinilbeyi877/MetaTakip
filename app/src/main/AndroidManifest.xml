<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.metatakip">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 📞 ÇAĞRI / TELEFON İZİNLERİ — CallReceiver bunlar olmadan PHONE_STATE almıyordu -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- 📒 REHBER (rehberden müşteri ismi çekmek için) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <!-- 💬 SMS -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- 🔁 BOOT + FOREGROUND SERVICE -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 🪟 OVERLAY (popup) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 📷 KAMERA + DEPOLAMA -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:name=".MetaTakipApp"
        android:allowBackup="true"

        android:enableOnBackInvokedCallback="true"

    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:theme="@style/Theme.AppCompat.Light.NoActionBar"
    android:usesCleartextTraffic="true"
    tools:targetApi="31"
    tools:replace="android:theme">





        <!-- ===================== -->
        <!-- 🆕 SİPARİŞ BİLDİRİM SERVİSİ -->
        <!-- ===================== -->
        <service
            android:name=".controllers.services.OrderNotificationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Popup Dialog Activity -->
        <activity
            android:name=".controllers.services.OrderPopupActivity"
            android:theme="@style/Theme.AppCompat.Dialog"
            android:exported="false"
            android:launchMode="singleInstance" />
    <!-- ===================== -->
    <!-- 📞 RECEIVERS -->
    <!-- ===================== -->
    <receiver
        android:name=".controllers.poupsms.CallReceiver"
        android:enabled="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.PHONE_STATE" />
        </intent-filter>
    </receiver>

    <receiver
        android:name=".controllers.poupsms.DebugReceiver"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.PHONE_STATE" />
            <action android:name="android.telephony.action.PHONE_STATE_CHANGED" />
            <action android:name="com.example.metatakip.TEST_CALL_RECEIVER" />
        </intent-filter>
    </receiver>

    <receiver
        android:name=".controllers.poupsms.BootCompleteReceiver"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.BOOT_COMPLETED" />
        </intent-filter>
    </receiver>

        <activity
            android:name=".controllers.OrderActive.SiparisBilgiEkleActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />






        <activity
            android:name=".controllers.OrderActive.DialogUrunEkleActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:windowSoftInputMode="stateVisible|adjustResize" />

    <!-- ===================== -->
    <!-- 📞 SERVICES -->
    <!-- ===================== -->
    <service
        android:name=".controllers.poupsms.CallScreeningServiceImpl"
        android:permission="android.permission.BIND_SCREENING_SERVICE"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:exported="true"
        android:foregroundServiceType="phoneCall">
        <intent-filter>
            <action android:name="android.telecom.CallScreeningService" />
        </intent-filter>
    </service>

    <service
        android:name=".controllers.poupsms.CallForegroundService"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:exported="false"
        android:foregroundServiceType="phoneCall" />

    <service
        android:name=".controllers.poupsms.NotificationService"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:exported="false" />

    <!-- ===================== -->
    <!-- 🟢 AKTİVİTELER -->
    <!-- ===================== -->

    <activity
        android:name=".controllers.LoginActivity"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
    </activity>


        <activity
            android:name="com.example.metatakip.feature_backup.ui.BackupRestoreActivity"
            android:exported="false" />

        <!-- YENİ: Canlı Takip Activity'si -->
        <activity android:name=".feature_backup.ui.LiveChangesActivity" />

    <activity
        android:name=".controllers.HomeActive.HomeActivity"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:exported="false" />

    <activity
        android:name=".controllers.adminConfigiration.AdminConfigurationActivity"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:exported="false" />

    <activity
        android:name=".controllers.poupsms.CallPopupActivity"
        android:exported="false"
        android:launchMode="singleInstance"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

    <activity
        android:name=".controllers.callphonelast.CallLogsListActivity"
        android:label="Çağrı Kayıtları"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:exported="false" />

    <activity
        android:name=".controllers.allGenericFormAndList.NotificationLogActivity"
        android:label="Bildirim Kayıtları"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:exported="false" />

    <activity
        android:name=".controllers.callphonelast.AddCallLogActivity"
        android:label="Çağrı Kayıt Ekle"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:exported="false" />



    <activity
        android:name=".test.DeleteHistoryActivity"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:exported="false" />

    <activity
        android:name=".controllers.poupsms.TestCallActivity"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:exported="false" />

    <activity
        android:name=".controllers.poupsms.AskSaveContactActivity"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:exported="false" />

    <activity
        android:name=".controllers.allGenericFormAndList.GenericFormActivity"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:exported="false" />






        <activity
            android:name=".controllers.allGenericFormAndList.GenericListActivity"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
            android:exported="true">

            <intent-filter>
                <action android:name="com.example.metatakip.OPEN_GENERIC_LIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

    <activity
        android:name=".controllers.callphonelast.DeviceSetupActivity"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:exported="false" />

    <!-- FILE PROVIDER -->
    <provider
        android:name="androidx.core.content.FileProvider"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:authorities="${applicationId}.provider"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
    </provider>

    <receiver
        android:name=".receivers.CallStateReceiver"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.PHONE_STATE" />
        </intent-filter>
    </receiver>

    <service
        android:name=".controllers.callphonelast.CentralServerService"
        android:exported="false"
        android:foregroundServiceType="dataSync" />



        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.metatakip.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>




        <!-- SMS durumu için BroadcastReceiver -->
        <receiver
            android:name="dao.SMSHelper$SmsStatusReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.metatakip.SMS_SENT" />
                <action android:name="com.example.metatakip.SMS_DELIVERED" />
            </intent-filter>
        </receiver>

</application>

    </manifest>
