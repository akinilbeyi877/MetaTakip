<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- BAŞLIK -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#1976D2"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Etiket Icerigi"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- TAB -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#F5F7FA">

        <Button
            android:id="@+id/tabBilesen"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Bilesen Sec"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1976D2"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="?android:attr/borderlessButtonStyle"/>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#DDDDDD"/>

        <Button
            android:id="@+id/tabElIle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="El ile Yaz"
            android:textSize="13sp"
            android:textColor="#1976D2"
            android:backgroundTint="#E3F2FD"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>

    <!-- PANEL 1: BİLEŞEN SEÇ -->
    <LinearLayout
        android:id="@+id/panelBilesen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="visible">

        <CheckBox
            android:id="@+id/chkSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Tumunu Sec"
            android:textSize="14sp"
            android:textColor="#212121"
            android:buttonTint="#1976D2"
            android:layout_marginBottom="4dp"/>

        <ExpandableListView
            android:id="@+id/expandableListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:groupIndicator="@null"
            android:divider="#F0F0F0"
            android:dividerHeight="1dp"/>
    </LinearLayout>

    <!-- PANEL 2: EL İLE YAZ -->
    <FrameLayout
        android:id="@+id/panelElIle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/etElIleYaz"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Etiket iceriginizi yazin..."
            android:inputType="textMultiLine"
            android:gravity="top|start"
            android:padding="12dp"
            android:background="@drawable/bg_input_border"
            android:textSize="13sp"
            android:textColor="#212121"
            android:fontFamily="monospace"/>
    </FrameLayout>

    <!-- AYIRICI -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"/>

    <!-- ÖNİZLEME BAŞLIK -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="#EEF2F7"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <View
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:background="#1976D2"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Etiket Onizleme"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#1976D2"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="canli guncellenir"
            android:textSize="10sp"
            android:textColor="#9E9E9E"/>
    </LinearLayout>

    <!-- KAĞIT ÖNİZLEME -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="#F0F0F0"
        android:padding="10dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="3dp"
            android:layout_marginStart="3dp"
            android:background="#33000000"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <View android:layout_width="50dp" android:layout_height="4dp"
                android:background="#1976D2" android:layout_marginBottom="4dp"/>
            <View android:layout_width="100dp" android:layout_height="2dp"
                android:background="#E0E0E0" android:layout_marginBottom="8dp"/>

            <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:scrollbars="vertical">
                <TextView
                    android:id="@+id/tvOnizleme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#212121"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"/>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- ALT BUTONLAR -->
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF">
        <Button android:id="@+id/btnIptal"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp"
            android:text="Iptal" android:textColor="#666666"
            android:backgroundTint="@android:color/transparent"
            style="?android:attr/borderlessButtonStyle"/>
        <Button android:id="@+id/btnKaydetDevam"
            android:layout_width="0dp" android:layout_weight="2" android:layout_height="42dp"
            android:text="KAYDET / DEVAM"
            android:backgroundTint="#1976D2" android:textColor="@android:color/white"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>